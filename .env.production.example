# Production-only template. Copy to .env.production and replace every placeholder.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<generate-a-random-50-plus-character-secret>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=<api-hostname>
HEALTH_CHECK_TOKEN=<generate-a-random-32-plus-character-secret>
DJANGO_ADMIN_PATH=<generate-per-environment>
ADMIN_IP_ALLOWLIST=<office-or-vpn-cidr>

FRONTEND_ORIGIN=https://<storefront-hostname>
CORS_ALLOWED_ORIGINS=https://<storefront-hostname>
CSRF_TRUSTED_ORIGINS=https://<storefront-hostname>,https://<api-hostname>
SESSION_COOKIE_DOMAIN=<shared-parent-domain>
NEXT_PUBLIC_API_BASE_URL=https://<api-hostname>
INTERNAL_API_BASE_URL=http://backend:8000

POSTGRES_DB=civicforest
POSTGRES_USER=civicforest
POSTGRES_PASSWORD=<generate-a-random-32-plus-character-secret>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://civicforest:<url-encoded-password>@postgres:5432/civicforest
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=<generate-a-random-32-plus-character-secret>
MEILISEARCH_INDEX_PREFIX=civicforest

S3_ENDPOINT_URL=<private-object-storage-endpoint>
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
S3_BUCKET_NAME=<bucket>
S3_REGION=auto

RAZORPAY_KEY_ID=<live-key-id>
RAZORPAY_KEY_SECRET=<live-key-secret>
RAZORPAY_WEBHOOK_SECRET=<separate-live-webhook-secret>
QIKINK_BASE_URL=https://api.qikink.com
QIKINK_CLIENT_ID=<client-id>
QIKINK_CLIENT_SECRET=<client-secret>
EMAIL_HOST=<smtp-host>
EMAIL_HOST_PASSWORD=<smtp-password>
GOOGLE_OAUTH_CLIENT_ID=<client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
