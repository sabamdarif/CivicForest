# CivicForest reverse proxy — terminates TLS with mkcert certs and splits traffic:
#   civicforest.local      → Next.js storefront
#   api.civicforest.local  → Django (API, allauth headless, admin, media)
#
# Same proxy software in dev and prod gives real parity, not just "https exists"
# (plan.md §2, §13). In production, drop the tls directives to let Caddy provision
# real certs automatically.

{
	# Local dev: no ACME. Certs are provided by mkcert (see make certs).
	auto_https off
}

civicforest.local {
	tls /etc/caddy/certs/civicforest.local.pem /etc/caddy/certs/civicforest.local-key.pem
	encode zstd gzip
	reverse_proxy frontend:3000
}

api.civicforest.local {
	tls /etc/caddy/certs/api.civicforest.local.pem /etc/caddy/certs/api.civicforest.local-key.pem
	encode zstd gzip

	# Forward the original scheme so Django's SECURE_PROXY_SSL_HEADER sees https.
	header {
		-Server
	}

	reverse_proxy backend:8000 {
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}
