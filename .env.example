# CivicForest environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored, so never commit secrets.
# Every variable below is read by `config/settings/`; nothing else reads the environment.

# ─── Core ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
# Comma-separated. Production wants the apex, www and .vercel.app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Unlocks the dependency detail on /healthz/; the bare 200 needs no token.
HEALTH_CHECK_TOKEN=dev-health-token-change-me

# The admin lives at a non-guessable path, never /admin/. Leave it unset and the admin
# is served on a path nobody can reach. Generate a fresh one per environment.
DJANGO_ADMIN_URL=
# Staff sessions expire faster than customer sessions.
STAFF_SESSION_AGE=3600

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Use Neon's *pooled* connection string. Leave blank locally to fall back to
# db.sqlite3, or set USE_SQLITE=1 to force SQLite even when this is filled in.
DATABASE_URL=
USE_SQLITE=1

# ─── Object storage (Cloudflare R2) ──────────────────────────────────────────
# Local development and tests stay on disk and need none of this. Production stores
# media in the private bucket and serves it through short-lived signed URLs.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PRIVATE_BUCKET_NAME=
S3_REGION=auto
S3_SIGNED_URL_TTL=3600
# CDN hostname in front of the public bucket, no trailing slash.
R2_PUBLIC_BASE_URL=

# ─── Cart / checkout pricing (server-side; the client never sends totals) ────
SHIPPING_FLAT_RATE=79.00
FREE_SHIPPING_THRESHOLD=999.00
CURRENCY=INR

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Hosted checkout keeps PCI scope at SAQ-A. The webhook secret is separate from the
# API secret and is set independently in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Print fulfilment (Qikink Open API) ──────────────────────────────────────
# Credentials from the Qikink dashboard. Base URL and paths are overridable so they can
# track Qikink's Postman reference without a deploy. Sandbox host by default.
QIKINK_BASE_URL=https://sandbox.qikink.com
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_TOKEN_PATH=/api/token
QIKINK_ORDER_CREATE_PATH=/api/order/create
QIKINK_ORDER_STATUS_PATH=/api/order/status
QIKINK_TOKEN_TTL=3600

# ─── Email ───────────────────────────────────────────────────────────────────
# Blank EMAIL_HOST means the console backend, which prints mail to the log. Production
# defaults to Resend over SMTP and needs only RESEND_API_KEY.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=CivicForest <no-reply@civicforest.com>
SUPPORT_EMAIL=

# ─── Social login (allauth) ──────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Error tracking (Sentry), optional and off when the DSN is blank ─────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development
