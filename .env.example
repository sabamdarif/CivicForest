# CivicForest environment template.
# Copy to `.env` and fill real values. `.env` is git-ignored — never commit secrets.

# ─── Core ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
# Comma-separated. Include the Django host(s) served through Caddy.
DJANGO_ALLOWED_HOSTS=api.civicforest.local,localhost,127.0.0.1,backend
# Shared only with internal orchestrator probes; use a random value in production.
HEALTH_CHECK_TOKEN=dev-health-token-change-me

# Admin lives at a non-guessable path (never /admin/). Change in every environment.
# Single source of truth: Django and Caddy both read DJANGO_ADMIN_PATH.
DJANGO_ADMIN_PATH=<generate-per-environment>

# ─── Frontend / CORS / CSRF ──────────────────────────────────────────────────
# The browser-facing origins of the Next.js app. Explicit allow-list, never "*".
FRONTEND_ORIGIN=https://civicforest.local
CORS_ALLOWED_ORIGINS=https://civicforest.local
CSRF_TRUSTED_ORIGINS=https://civicforest.local,https://api.civicforest.local
# Cookies are scoped to the shared parent domain so SSR + browser both send them.
SESSION_COOKIE_DOMAIN=.civicforest.local

# Public base URL of the Django API, used by the Next.js server for SSR fetches.
NEXT_PUBLIC_API_BASE_URL=https://api.civicforest.local
# Server-to-server base URL (inside the Docker network, TLS-terminated by Caddy).
INTERNAL_API_BASE_URL=http://backend:8000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=civicforest
POSTGRES_USER=civicforest
POSTGRES_PASSWORD=civicforest-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://civicforest:civicforest-dev-password@postgres:5432/civicforest

# ─── Redis (cache, Celery broker, throttle store) ────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Meilisearch ─────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=meili-dev-master-key-change-me
MEILISEARCH_INDEX_PREFIX=civicforest

# ─── Object storage (S3 / Cloudflare R2) — design uploads + media ────────────
# Leave S3_BUCKET_NAME blank for local-disk storage (dev). Set it (plus keys) to
# switch default storage to private S3/R2 with signed URLs. Design files must never
# live on the app disk in production (plan.md §8, §12).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto

# ─── Cart / checkout pricing (server-side; client never sends totals) ────────
SHIPPING_FLAT_RATE=59.00
FREE_SHIPPING_THRESHOLD=999.00
CURRENCY=INR

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Hosted checkout keeps PCI scope at SAQ-A. Webhook secret is separate from the
# API secret and set independently in the Razorpay dashboard (plan.md §9).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Print fulfilment (Qikink Open API) ──────────────────────────────────────
# Credentials from the Qikink dashboard. Base URL/paths are overridable so they can
# track Qikink's Postman reference without a code change. Sandbox host by default.
QIKINK_BASE_URL=https://sandbox.qikink.com
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_TOKEN_PATH=/api/token
QIKINK_ORDER_CREATE_PATH=/api/order/create
QIKINK_ORDER_STATUS_PATH=/api/order/status
QIKINK_TOKEN_TTL=3600

# ─── Email (transactional: order confirmation / shipping / password reset) ────
# Leave EMAIL_HOST blank for the console backend (dev prints emails to logs). Set it
# plus credentials to deliver via any SMTP provider (plan.md §7).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CivicForest <no-reply@civicforest.local>

# ─── Error tracking (Sentry) — optional; disabled when DSN is blank ──────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# ─── Admin hardening ─────────────────────────────────────────────────────────
# Comma-separated CIDRs/IPs allowed to reach the admin at the Caddy layer. The app
# additionally requires staff to have confirmed TOTP MFA (plan.md §11).
ADMIN_IP_ALLOWLIST=
# Staff sessions expire faster than customer sessions.
STAFF_SESSION_AGE=3600

# ─── Social login (allauth) — UI built, keys optional ───────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_SECRET=
